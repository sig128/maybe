# MAYBE server configuration. Copy to .env for local overrides; never commit real secrets.
# Every value here is safe to share: local-only defaults, no secrets.

# localnet | devnet | production. Production refuses development attestors, local fixtures and local RPCs at startup.
MAYBE_MODE=localnet

# API
PORT=8787
HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:5173
# Domain that sign-in messages are bound to (host[:port] of the web app)
AUTH_DOMAIN=127.0.0.1:5173
SESSION_HOURS=12
RATE_LIMIT_PER_MINUTE=240
# Reverse proxies in front of the API that append to X-Forwarded-For (0 = rate-limit by the socket address)
TRUST_PROXY_HOPS=0

# PostgreSQL (local development role; change the password anywhere else)
DATABASE_URL=postgres://maybe:maybe-local-dev@127.0.0.1:5432/maybe

# Solana RPC (a local solana-test-validator by default)
RPC_URL=http://127.0.0.1:8899
# Address book written by scripts/localnet-setup.ts (localnet only; refused in production)
# LOCALNET_BOOK=.localnet/localnet.json

# Development attestors sign outcomes on localnet only. Must be false in production.
ALLOW_DEV_ATTESTORS=true

# Keeper fee-payer key for non-localnet modes (JSON byte array). Localnet uses programs/keys/localnet/keeper.json.
# KEEPER_KEYPAIR=

# Optional model provider for the agents. Without it, a clearly labelled deterministic local assistant runs.
# ANTHROPIC_API_KEY=
# MAYBE_AGENT_MODEL=

# Worker
WORKER_ID=worker-1
# MAYBE_JOB_LEASE_SECONDS=30
# A step that ran out of attempts but can still execute is retried after this many seconds
# MAYBE_JOB_REVIVE_SECONDS=300
# How long a crashed runner's intent stays leased before another process resumes it
# MAYBE_INTENT_LEASE_SECONDS=60
# Run the worker inside the API process (development convenience)
# MAYBE_WITH_WORKER=1

# Web app: point the browser at an API (omit for the in-browser simulation)
# VITE_MAYBE_API=http://127.0.0.1:8787
