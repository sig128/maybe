{
  "name": "@maybe/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MAYBE API (Hono) and workers: auth, drafts, authorization tx building, indexer, keeper, settlement watcher, reconciliation.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "worker": "tsx src/worker.ts",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@maybe/agent": "workspace:*",
    "@maybe/api": "workspace:*",
    "@maybe/core": "workspace:*",
    "@maybe/sdk": "workspace:*",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "bs58": "6.0.0",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
